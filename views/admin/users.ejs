<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Manage Users</title>

    <link
        rel="stylesheet"
        href="/css/styles.css"
    >

</head>


<body>

    <%- include("../partials/navbar") %>


    <main class="admin-page">

        <div class="admin-heading">

            <div>

                <p class="posts-eyebrow">
                    ADMINISTRATION
                </p>

                <h1>
                    Manage Users
                </h1>

                <p class="posts-description">
                    View all registered users and their roles.
                </p>

            </div>

        </div>


        <% if (users.length > 0) { %>

            <div class="admin-table-wrapper">

                <table class="admin-table">

                    <thead>

                        <tr>

                            <th>
                                Username
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Role
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        <% users.forEach(user => { %>

                            <tr>

                                <td>

                                    <div class="admin-user">

                                        <div class="admin-user-avatar">

                                            <%= user.username
                                                .charAt(0)
                                                .toUpperCase() %>

                                        </div>

                                        <span>
                                            <%= user.username %>
                                        </span>

                                    </div>

                                </td>


                                <td>
                                    <%= user.email %>
                                </td>


                                <td>

                                    <% if (user.role === "superadmin") { %>

                                        <span class="admin-role admin-role-super">
                                            Super Admin
                                        </span>

                                    <% } else { %>

                                        <span class="admin-role">
                                            User
                                        </span>

                                    <% } %>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>


        <% } else { %>

            <div class="empty-post">

                <div class="empty-icon">
                    ✦
                </div>

                <h2>
                    No users found
                </h2>

                <p>
                    There are currently no registered users.
                </p>

            </div>

        <% } %>


    </main>

</body>

</html>