<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Manage Users</title>

    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>

    <%- include("../partials/navbar") %>


    <main class="posts-page">

        <h1>Manage Users</h1>

        <p>
            View all registered users and their roles.
        </p>


        <% if (users.length === 0) { %>

            <article>

                <p>No users found.</p>

            </article>

        <% } else { %>


            <article class="users-table">

                <!-- TABLE HEADER -->

                <div class="user-row user-header">

                    <div>
                        Username
                    </div>

                    <div>
                        Email
                    </div>

                    <div>
                        Role
                    </div>

                </div>


                <!-- USERS -->

                <% users.forEach(user => { %>

                    <div class="user-row">

                        <div class="user-name">
                            <%= user.username %>
                        </div>


                        <div class="user-email">
                            <%= user.email %>
                        </div>


                        <div>

                            <% if (user.role === "superadmin") { %>

                                <span class="role superadmin">
                                    Super Admin
                                </span>

                            <% } else { %>

                                <span class="role">
                                    User
                                </span>

                            <% } %>

                        </div>

                    </div>

                <% }) %>

            </article>


        <% } %>

    </main>

</body>

</html>