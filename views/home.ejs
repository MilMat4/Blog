<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Blog</title>

    <link rel="stylesheet" href="/css/styles.css">

</head>


<body>


    <%- include("partials/navbar") %>


    <main>


        <!-- HERO -->

        <section class="hero">

            <h1>
                Welcome to My Blog
            </h1>

            <p>
                Discover amazing content and share your thoughts.
            </p>

            <a
                href="/posts/create"
                class="hero-btn"
            >
                Start Writing
            </a>

        </section>


        <!-- LATEST POSTS -->

        <section class="home-posts">

            <div class="home-posts-heading">

                <div>

                    <p class="posts-eyebrow">
                        FROM THE COMMUNITY
                    </p>

                    <h2>
                        Latest Stories
                    </h2>

                    <p class="posts-description">
                        Explore stories and ideas shared by our community.
                    </p>

                </div>


                <a
                    href="/posts"
                    class="view-all-button"
                >
                    View All
                </a>

            </div>


            <% if (posts && posts.length > 0) { %>


                <div class="home-carousel-wrapper">


                    <button
                        type="button"
                        class="carousel-button carousel-left"
                        onclick="scrollPosts(-1)"
                    >
                        ‹
                    </button>


                    <div
                        class="home-carousel"
                        id="homeCarousel"
                    >


                        <% posts.forEach(post => { %>


                            <article class="home-post-card">


                                <!-- IMAGE -->

                                <% if (post.image) { %>

                                    <div class="home-post-image">

                                        <img
                                            src="<%= post.image && post.image.startsWith('http') ? post.image : '/assets/' + post.image %>"
                                            alt="<%= post.title %>"
                                        >

                                    </div>

                                <% } else { %>

                                    <div class="home-post-image home-post-no-image">

                                        <span>✦</span>

                                    </div>

                                <% } %>


                                <!-- CONTENT -->

                                <div class="home-post-content">


                                    <% if (post.author) { %>

                                        <div class="home-post-author">

                                            <div class="author-avatar">

                                                <%= post.author.username
                                                    .charAt(0)
                                                    .toUpperCase() %>

                                            </div>

                                            <span>
                                                <%= post.author.username %>
                                            </span>

                                        </div>

                                    <% } else { %>

                                        <div class="home-post-author">

                                            <div class="author-avatar">
                                                ?
                                            </div>

                                            <span>Unknown author</span>

                                        </div>

                                    <% } %>


                                    <h3>
                                        <%= post.title %>
                                    </h3>


                                    <p>

                                        <%= post.content.length > 120
                                            ? post.content.substring(0, 120) + "..."
                                            : post.content %>

                                    </p>


                                    <a
                                        href="/posts/<%= post._id %>"
                                        class="read-more"
                                    >
                                        Read More →
                                    </a>


                                </div>


                            </article>


                        <% }) %>


                    </div>


                    <button
                        type="button"
                        class="carousel-button carousel-right"
                        onclick="scrollPosts(1)"
                    >
                        ›
                    </button>


                </div>


            <% } else { %>


                <div class="empty-post">

                    <div class="empty-icon">
                        ✦
                    </div>

                    <h2>
                        No stories yet
                    </h2>

                    <p>
                        Be the first person to share something with the community.
                    </p>

                    <a
                        href="/posts/create"
                        class="hero-btn"
                    >
                        Create the first post
                    </a>

                </div>


            <% } %>


        </section>


    </main>


    <script>

        function scrollPosts(direction) {

            const carousel =
                document.getElementById("homeCarousel");

            if (!carousel) {
                return;
            }

            const scrollAmount = 350;
            const maxScroll = carousel.scrollWidth - carousel.clientWidth;
            const nextScroll = carousel.scrollLeft + direction * scrollAmount;

            let targetScroll = nextScroll;

            if (nextScroll > maxScroll) {
                targetScroll = 0;
            }

            if (nextScroll < 0) {
                targetScroll = maxScroll;
            }

            carousel.scrollTo({

                left: targetScroll,

                behavior: "smooth"

            });

        }

    </script>


</body>

</html>