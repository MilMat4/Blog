<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Edit Post</title>

    <link rel="stylesheet" href="/css/styles.css">

</head>


<body>


    <%- include("../partials/navbar") %>


    <main class="auth-page">

        <h1>
            Edit Post
        </h1>


        <form
            action="/posts/<%= post._id %>/edit"
            method="POST"
            enctype="multipart/form-data"
        >


            <label for="title">
                Title
            </label>

            <input
                type="text"
                id="title"
                name="title"
                value="<%= post.title %>"
                required
            >


            <label for="content">
                Content
            </label>

            <textarea
                id="content"
                name="content"
                rows="8"
                required
            ><%= post.content %></textarea>


            <label for="image">
                Image
            </label>

            <input
                type="file"
                id="image"
                name="image"
                accept="image/*"
            >


            <% if (post.image) { %>

                <p>
                    Current image:
                </p>

                <img
                    src="/assets/<%= post.image %>"
                    alt="<%= post.title %>"
                    width="300"
                >

            <% } %>


            <button type="submit">
                Update Post
            </button>


        </form>


    </main>


</body>

</html>