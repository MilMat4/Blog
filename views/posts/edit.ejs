<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Edit Post</title>

    <link rel="stylesheet" href="/css/styles.css">

</head>


<body>

    <%- include("../partials/navbar") %>


    <main class="post-form-page">

        <div class="post-form-card">

            <p class="posts-eyebrow">
                UPDATE YOUR STORY
            </p>

            <h1>
                Edit Story
            </h1>


            <form
                action="/posts/<%= post._id %>/edit"
                method="POST"
                enctype="multipart/form-data"
                class="post-form"
            >


                <!-- TITLE -->

                <div>

                    <label for="title">
                        Title
                    </label>

                    <input
                        type="text"
                        id="title"
                        name="title"
                        value="<%= post.title %>"
                        placeholder="Give your story a title..."
                        required
                    >

                </div>


                <!-- CONTENT -->

                <div>

                    <label for="content">
                        Your Story
                    </label>

                    <textarea
                        id="content"
                        name="content"
                        placeholder="Start writing your story..."
                        required
                    ><%= post.content %></textarea>

                </div>


                <!-- CURRENT IMAGE -->

                <% if (post.image) { %>

                    <div class="current-post-image">

                        <label>
                            Current Image
                        </label>

                        <img
                            src="/assets/<%= post.image %>"
                            alt="<%= post.title %>"
                        >

                    </div>

                <% } %>


                <!-- NEW IMAGE -->

                <div>

                    <label for="image">
                        Replace Image
                    </label>

                    <input
                        type="file"
                        id="image"
                        name="image"
                        accept="image/*"
                    >

                    <small class="image-help">
                        Leave empty to keep the current image.
                    </small>

                </div>


                <!-- BUTTONS -->

                <div class="post-form-actions">

                    <a
                        href="/posts"
                        class="cancel-button"
                    >
                        Cancel
                    </a>


                    <button
                        type="submit"
                        class="publish-button"
                    >
                        Save Changes
                    </button>

                </div>


            </form>

        </div>

    </main>

</body>

</html>