<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Create Post</title>

    <link rel="stylesheet" href="/css/styles.css">

</head>


<body>


    <%- include("../partials/navbar") %>


    <main class="auth-page">

        <h1>
            Create Post
        </h1>


        <form
            action="/posts/create"
            method="POST"
            enctype="multipart/form-data"
        >


            <label for="title">
                Title
            </label>

            <input
                type="text"
                id="title"
                name="title"
                required
            >


            <label for="content">
                Content
            </label>

            <textarea
                id="content"
                name="content"
                rows="8"
                required
            ></textarea>


            <label for="image">
                Image
            </label>

            <input
                type="file"
                id="image"
                name="image"
                accept="image/*"
            >


            <button type="submit">
                Create Post
            </button>


        </form>


    </main>


</body>

</html>