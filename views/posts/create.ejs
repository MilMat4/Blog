<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Create Post</title>

    <link rel="stylesheet" href="/css/styles.css">

</head>


<body>

    <%- include("../partials/navbar") %>


    <main class="post-form-page">

        <div class="post-form-card">

            <p class="posts-eyebrow">
                SHARE YOUR THOUGHTS
            </p>

            <h1>
                Create a New Story
            </h1>


            <form
                action="/posts/create"
                method="POST"
                enctype="multipart/form-data"
                class="post-form"
            >


                <!-- TITLE -->

                <div>

                    <label for="title">
                        Title
                    </label>

                    <input
                        type="text"
                        id="title"
                        name="title"
                        placeholder="Give your story a title..."
                        required
                    >

                </div>


                <!-- CONTENT -->

                <div>

                    <label for="content">
                        Your Story
                    </label>

                    <textarea
                        id="content"
                        name="content"
                        placeholder="Start writing your story..."
                        required
                    ></textarea>

                </div>


                <!-- IMAGE -->

                <div>

                    <label for="image">
                        Add an Image
                    </label>

                    <input
                        type="file"
                        id="image"
                        name="image"
                        accept="image/*"
                    >

                </div>


                <!-- BUTTONS -->

                <div class="post-form-actions">

                    <a
                        href="/posts"
                        class="cancel-button"
                    >
                        Cancel
                    </a>


                    <button
                        type="submit"
                        class="publish-button"
                    >
                        Publish Story
                    </button>

                </div>


            </form>

        </div>

    </main>

</body>

</html>