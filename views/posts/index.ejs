<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Posts</title>

    <link rel="stylesheet" href="/css/styles.css">

</head>


<body>


    <%- include("../partials/navbar") %>


    <main class="posts-page">

        <h1>
            Blog Posts
        </h1>


        <a
            href="/posts/create"
            class="hero-btn"
        >
            Create Post
        </a>


        <% if (posts.length === 0) { %>

            <p>
                No posts yet.
            </p>

        <% } else { %>


            <% posts.forEach(post => { %>

                <article>


                    <h2>
                        <%= post.title %>
                    </h2>


                    <p>
                        Posted by

                        <strong>
                            <%= post.author.username %>
                        </strong>
                    </p>


                    <p>
                        <%= post.content %>
                    </p>


                    <% if (post.image) { %>

                        <img
                            src="/assets/<%= post.image %>"
                            alt="<%= post.title %>"
                        >

                    <% } %>


                    <a
                        href="/posts/<%= post._id %>/edit"
                    >
                        Edit
                    </a>


                    <form
                        action="/posts/<%= post._id %>/delete"
                        method="POST"
                    >

                        <button type="submit">
                            Delete
                        </button>

                    </form>


                </article>


            <% }) %>


        <% } %>


    </main>


</body>

</html>